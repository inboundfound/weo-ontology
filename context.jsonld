{
  "@context": {
    "weo": "https://inboundfound.github.io/weo-ontology/weo#",
    "schema": "https://schema.org/",
    "prov": "http://www.w3.org/ns/prov#",
    "skos": "http://www.w3.org/2004/02/skos/core#",
    "dct": "http://purl.org/dc/terms/",
    "xsd": "http://www.w3.org/2001/XMLSchema#",

    "id": "@id",
    "type": "@type",

    "Website": "weo:Website",
    "URL": "weo:URL",
    "Term": "weo:Term",
    "Crawl": "weo:Crawl",
    "SerpSnapshot": "weo:SerpSnapshot",
    "Topic": "weo:Topic",
    "SearchPerformanceFact": "weo:SearchPerformanceFact",
    "Engine": "weo:Engine",
    "SearchEngine": "weo:SearchEngine",
    "GenerativeEngine": "weo:GenerativeEngine",
    "AnswerEngine": "weo:AnswerEngine",
    "ConversationalAgent": "weo:ConversationalAgent",
    "Brand": "weo:Brand",
    "Prompt": "weo:Prompt",
    "LLMResponse": "weo:LLMResponse",
    "SearchIntent": "weo:SearchIntent",
    "ConversionPoint": "weo:ConversionPoint",
    "CallToAction": "weo:CallToAction",
    "LeadCaptureForm": "weo:LeadCaptureForm",
    "GatedAsset": "weo:GatedAsset",
    "ConversionEvent": "weo:ConversionEvent",

    "partOf": { "@id": "weo:partOf", "@type": "@id" },
    "hasCrawl": { "@id": "weo:hasCrawl", "@type": "@id" },
    "fetched": { "@id": "weo:fetched", "@type": "@id" },
    "linksTo": { "@id": "weo:linksTo", "@type": "@id" },
    "redirectsTo": { "@id": "weo:redirectsTo", "@type": "@id" },
    "hasCanonical": { "@id": "weo:hasCanonical", "@type": "@id" },
    "ranksFor": { "@id": "weo:ranksFor", "@type": "@id" },
    "hasSnapshot": { "@id": "weo:hasSnapshot", "@type": "@id" },
    "hasResult": { "@id": "weo:hasResult", "@type": "@id" },
    "inTopic": { "@id": "weo:inTopic", "@type": "@id" },
    "childOf": { "@id": "weo:childOf", "@type": "@id" },
    "scopedTo": { "@id": "weo:scopedTo", "@type": "@id" },
    "tracksPrompt": { "@id": "weo:tracksPrompt", "@type": "@id" },
    "hasResponse": { "@id": "weo:hasResponse", "@type": "@id" },
    "onEngine": { "@id": "weo:onEngine", "@type": "@id" },
    "cites": { "@id": "weo:cites", "@type": "@id" },
    "mentions": { "@id": "weo:mentions", "@type": "@id" },
    "fansOutTo": { "@id": "weo:fansOutTo", "@type": "@id" },
    "visibilityFor": { "@id": "weo:visibilityFor", "@type": "@id" },
    "targetsIntent": { "@id": "weo:targetsIntent", "@type": "@id" },
    "hasConversionPoint": { "@id": "weo:hasConversionPoint", "@type": "@id" },
    "capturedBy": { "@id": "weo:capturedBy", "@type": "@id" },
    "attributedResponse": { "@id": "weo:attributedResponse", "@type": "@id" },

    "websiteId": "weo:websiteId",
    "origin": "weo:origin",
    "address": "weo:address",
    "name": "weo:name",
    "text": "weo:text",
    "title": "weo:title",
    "metaDescription": "weo:metaDescription",
    "anchorText": "weo:anchorText",
    "rel": "weo:rel",
    "resultType": "weo:resultType",
    "method": "weo:method",
    "model": "weo:model",
    "modelVersion": "weo:modelVersion",
    "source": "weo:source",
    "datasetUri": "weo:datasetUri",
    "crmRecordRef": "weo:crmRecordRef",
    "embeddingRef": "weo:embeddingRef",
    "embeddingModel": "weo:embeddingModel",

    "statusCode": { "@id": "weo:statusCode", "@type": "xsd:integer" },
    "clicks": { "@id": "weo:clicks", "@type": "xsd:integer" },
    "impressions": { "@id": "weo:impressions", "@type": "xsd:integer" },
    "position": { "@id": "weo:position", "@type": "xsd:integer" },
    "citationRank": { "@id": "weo:citationRank", "@type": "xsd:integer" },
    "mentionRank": { "@id": "weo:mentionRank", "@type": "xsd:integer" },
    "responses": { "@id": "weo:responses", "@type": "xsd:integer" },

    "avgPosition": { "@id": "weo:avgPosition", "@type": "xsd:decimal" },
    "ctr": { "@id": "weo:ctr", "@type": "xsd:decimal" },
    "confidence": { "@id": "weo:confidence", "@type": "xsd:decimal" },
    "mentionRate": { "@id": "weo:mentionRate", "@type": "xsd:decimal" },
    "citationRate": { "@id": "weo:citationRate", "@type": "xsd:decimal" },

    "webSearchEnabled": { "@id": "weo:webSearchEnabled", "@type": "xsd:boolean" },

    "capturedAt": { "@id": "weo:capturedAt", "@type": "xsd:dateTime" },
    "fetchedAt": { "@id": "weo:fetchedAt", "@type": "xsd:dateTime" },
    "occurredAt": { "@id": "weo:occurredAt", "@type": "xsd:dateTime" },
    "firstSeenAt": { "@id": "weo:firstSeenAt", "@type": "xsd:dateTime" },
    "lastSeenAt": { "@id": "weo:lastSeenAt", "@type": "xsd:dateTime" },
    "assignedAt": { "@id": "weo:assignedAt", "@type": "xsd:dateTime" },
    "periodStart": { "@id": "weo:periodStart", "@type": "xsd:date" },
    "periodEnd": { "@id": "weo:periodEnd", "@type": "xsd:date" }
  }
}
